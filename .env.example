# PostgreSQL connection string (leave unset to use local SQLite)
# DATABASE_URL=postgresql://user:password@host:5432/queueflow

# Redis connection string for distributed rate limiting & analytics caching
# REDIS_URL=redis://localhost:6379/0

# AES-256-GCM encryption key for PII fields (phone, notes) at rest
AES_ENCRYPTION_KEY=replace-with-a-strong-random-secret-key

# Optional: Google OAuth 2.0 Web Client ID for "Continue with Google" login
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
